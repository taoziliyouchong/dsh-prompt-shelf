{
  "name": "dsh-prompt-shelf",
  "version": "0.1.4",
  "description": "在输入框工具行里存常用提示词：搜索、插入或整框替换，带变量与回收站。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "src",
    "lib/client.js",
    "scripts",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-alpha.1"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prompt",
    "snippet",
    "template",
    "ui"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "check": "node --check index.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "author": "taoziliyouchong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/taoziliyouchong/dsh-prompt-shelf"
  },
  "homepage": "https://github.com/taoziliyouchong/dsh-prompt-shelf#readme",
  "bugs": {
    "url": "https://github.com/taoziliyouchong/dsh-prompt-shelf/issues"
  }
}
